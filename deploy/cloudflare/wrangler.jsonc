{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "barorok",
  "account_id": "57140ab2a81a65bf7507b8de95334a06",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "main": "src/index.ts",
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "barorok-releases" }],
  "assets": {
    "directory": "../../.tmp/cloudflare-web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/downloads/*"],
    "not_found_handling": "single-page-application"
  }
}
