        "component": "Sidebar",
        "desktopWidthPx": 272,
        "persistent": true
      },
      {
        "id": "workspace",
        "component": "Workspace",
        "scrollOwner": true,
        "persistent": true
      },
      {
        "id": "overlay",
        "component": "OverlayLayer",
        "persistent": false
      }
    ],
    "desktop": {
      "maxWidthPx": 1360,
