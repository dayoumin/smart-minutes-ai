    "behavior": [
      "desktop-app/src/App.tsx",
      "desktop-app/src/Sidebar.tsx",
      "desktop-app/src/MeetingWriter.tsx",
      "desktop-app/src/MeetingHistory.tsx",
      "desktop-app/src/Settings.tsx"
